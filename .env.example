# Environment variables for the local stack (`make up`).
#
#   cp .env.example .env    # then edit .env; it is git-ignored
#
# Every variable the project reads is listed here with a safe local default.
# The values below are for local development only; they are not secrets.
# Real dev/prod values live in the server's per-environment .env files and in
# GitHub environment secrets, never in git (see _docs/deployment.md).
# Any PR that introduces a new variable adds it here in the same PR.

# --- Compose project: one local stack per checkout (#83) ----------------------
# Compose names the containers, network, database volume and app image after the
# project, so each checkout's stack is separate. The main checkout keeps the default
# below. A second git worktree for a parallel Claude Code session (_docs/process.md,
# Parallel sessions) gives its .env a project name of its own and adds 10 to every
# host port further down, so both stacks run at once:
#   COMPOSE_PROJECT_NAME=focus-m3
#   POSTGRES_PORT=5442
#   GRAFANA_PORT=3010
#   OTLP_GRPC_PORT=4327
#   OTLP_HTTP_PORT=4328
#   APP_PORT=8010
#   DATABASE_URL=postgresql+asyncpg://focus:focus@localhost:5442/focus
# `make up` prints the project and the URLs actually in use.
COMPOSE_PROJECT_NAME=focus-local

# --- Database (Postgres container `db`) -------------------------------------
# Superuser, password and database created on first start of the volume.
POSTGRES_USER=focus
POSTGRES_PASSWORD=focus
POSTGRES_DB=focus
# Host port Postgres is published on (127.0.0.1 only). Change if 5432 is taken.
POSTGRES_PORT=5432

# --- Local observability (grafana/otel-lgtm container `lgtm`) ----------------
# Host port for the Grafana UI: http://localhost:3000 (127.0.0.1 only).
GRAFANA_PORT=3000
# Host ports for OTLP ingest (gRPC and HTTP).
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
# How often the app container exports metrics to lgtm, in milliseconds.
OTEL_METRIC_EXPORT_INTERVAL=15000

# --- App container (compose service `app`) ------------------------------------
# Host port the app is published on: http://localhost:8000 (127.0.0.1 only). The e2e
# targets test this checkout's app, and the Vite dev server proxies /api to APP_PORT
# taken from its own environment (frontend/vite.config.ts), not from this file.
APP_PORT=8000
# 1 (default): the container runs `alembic upgrade head` before starting the server,
# and a failed migration stops it. 0: skip that step (deploys migrate separately and
# roll back to older images with it off; see _docs/deployment.md).
MIGRATE_ON_START=1
# Inside Compose the app gets its own DATABASE_URL (host `db`, built from the
# POSTGRES_* values above) and the OTEL_* exporter settings that point at `lgtm`;
# see compose.yaml. The DATABASE_URL below is for running the backend on the host.

# --- Backend app (backend/app/config.py) --------------------------------------
# The app reads environment variables only, never this file. Compose reads it and
# passes every setting below on to the app container (compose.yaml), except
# DATABASE_URL and FRONTEND_DIST (the image serves its own build). Unset ones get the
# app's own defaults (COOKIE_SECURE: 0 locally), and editing one here takes effect on
# the next `make up`. To run the backend on the host,
# set them in its environment instead (backend/README.md).
# SQLAlchemy async URL. Default matches the compose `db` service on localhost.
DATABASE_URL=postgresql+asyncpg://focus:focus@localhost:5432/focus
# Python log level for the JSON logs on stdout.
LOG_LEVEL=INFO
# Built frontend served by the app (default: <repo>/frontend/dist; absent in dev).
# FRONTEND_DIST=
# Session cookie `Secure` flag; when on, the cookie is named `__Host-focus_session`. The app defaults to 1 (safe). 0 is only for plain-http
# local work, where browsers and curl drop Secure cookies: compose.yaml passes 0 to the
# local app container unless this says otherwise, and a backend run on the host needs
# `COOKIE_SECURE=0` in its environment (setting it here alone does nothing there).
# Never 0 in dev or prod: their server .env files leave it unset.
COOKIE_SECURE=0
# Days a sign-in lasts.
SESSION_TTL_DAYS=30
# Rate limit on failed sign-ins within SIGNIN_WINDOW_SECONDS: per client+email, and per client.
SIGNIN_MAX_FAILURES=5
SIGNIN_MAX_FAILURES_PER_CLIENT=20
SIGNIN_WINDOW_SECONDS=900
# Sign-ups allowed per client within SIGNUP_WINDOW_SECONDS (each runs a full argon2 hash).
# IPv6 clients are grouped by /64.
SIGNUP_MAX_PER_CLIENT=10
SIGNUP_WINDOW_SECONDS=3600
# Seconds /readyz waits for the database before answering 503.
READINESS_TIMEOUT_SECONDS=2
# Alert trigger (#33), operator only: the share of session save requests (single saves
# and sync batches), 0 to 100, that fail on purpose with a 500 and count as
# outcome="error", so the session-save alert fires. 0 = off, the default. Read once at
# startup; no endpoint reads or changes it. Locally:
#   FAULT_SAVE_ERROR_PERCENT=30 docker compose up -d app    # then scripts/traffic.py
# _docs/observability.md, Alert trigger.
FAULT_SAVE_ERROR_PERCENT=0

# --- Reviewer GitHub App (scripts/reviewer_token.py, scripts/reviewer-review.sh; #70) ---
# The reviewer agent posts its PR reviews as this App's bot, so its approval counts
# toward the approving review branch protection on `main` requires. The App ID and
# installation ID are public; the defaults below are the real ones and the scripts
# use them when these variables are unset. The private key is a secret: it stays
# outside the repo (mode 600) and only the token script reads it, at runtime.
REVIEWER_APP_ID=5420413
REVIEWER_INSTALLATION_ID=173980330
REVIEWER_APP_KEY_PATH=~/.config/ineedtofocus/reviewer-app.pem

# --- Deployed environments: /opt/focus/prod/.env and /opt/focus/dev/.env (#27) ---------
# Not used locally: they are commented out here so `cp .env.example .env` changes
# nothing. On the server each environment's file holds ONLY its secrets, mode 600,
# owner deploy (_docs/deployment.md). infra/compose.sh passes it to
# infra/compose.prod.yml before the committed, non-secret settings in
# infra/env/<env>.env (sizes, network, proxy trust), which win. A variable from the
# local sections above has no effect there, except LOG_LEVEL and
# FAULT_SAVE_ERROR_PERCENT.
#
# Required. Postgres password for this environment, also used in the app's
# DATABASE_URL, so keep it URL-safe: `openssl rand -hex 32`. Prod and dev differ.
# POSTGRES_PASSWORD=
#
# Optional. Python log level (default INFO).
# LOG_LEVEL=INFO
#
# Optional, operator only: the alert trigger (#33), off (0) by default. Set it to fire
# the session-save alert on purpose, then recreate the app; set it back to 0 (or delete
# the line) and recreate the app to stop. A rollback keeps it, since it reads this file.
#   APP_TAG=<current tag> infra/compose.sh <env> up -d app
# FAULT_SAVE_ERROR_PERCENT=0
#
# Grafana Cloud OTLP (#32), read only by this environment's OpenTelemetry Collector.
# While GRAFANA_CLOUD_OTLP_ENDPOINT is empty the collector accepts telemetry and drops
# it; once it's set, the collector forwards to Grafana Cloud with basic auth (instance
# ID as user, token as password). The token lives only in these server files, never in
# git or GitHub secrets. Recreate the collector after a change:
#   APP_TAG=<current tag> infra/compose.sh <env> up -d otel-collector
# The stack's endpoint and instance ID (not secrets; _docs/observability.md):
# GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-3.grafana.net/otlp
# GRAFANA_CLOUD_INSTANCE_ID=1889715
# GRAFANA_CLOUD_OTLP_TOKEN=
#
# APP_TAG (the image tag = commit SHA to run) is NOT kept here: deploy and rollback
# (#28-#30) pass it in the environment when they call infra/compose.sh.
