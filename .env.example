# Environment variables for the local stack (`make up`).
#
#   cp .env.example .env    # then edit .env; it is git-ignored
#
# Every variable the project reads is listed here with a safe local default.
# The values below are for local development only; they are not secrets.
# Real dev/prod values live in the server's per-environment .env files and in
# GitHub environment secrets, never in git (see _docs/deployment.md).
# Any PR that introduces a new variable adds it here in the same PR.

# --- Database (Postgres container `db`) -------------------------------------
# Superuser, password and database created on first start of the volume.
POSTGRES_USER=focus
POSTGRES_PASSWORD=focus
POSTGRES_DB=focus
# Host port Postgres is published on (127.0.0.1 only). Change if 5432 is taken.
POSTGRES_PORT=5432

# --- Local observability (grafana/otel-lgtm container `lgtm`) ----------------
# Host port for the Grafana UI: http://localhost:3000 (127.0.0.1 only).
GRAFANA_PORT=3000
# Host ports for OTLP ingest (gRPC and HTTP).
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
# How often the app container exports metrics to lgtm, in milliseconds.
OTEL_METRIC_EXPORT_INTERVAL=15000

# --- App container (compose service `app`) ------------------------------------
# Host port the app is published on: http://localhost:8000 (127.0.0.1 only).
APP_PORT=8000
# 1 (default): the container runs `alembic upgrade head` before starting the server,
# and a failed migration stops it. 0: skip that step (deploys migrate separately and
# roll back to older images with it off; see _docs/deployment.md).
MIGRATE_ON_START=1
# Inside Compose the app gets its own DATABASE_URL (host `db`, built from the
# POSTGRES_* values above) and the OTEL_* exporter settings that point at `lgtm`;
# see compose.yaml. The DATABASE_URL below is for running the backend on the host.

# --- Backend app (read by backend/app/config.py) -----------------------------
# SQLAlchemy async URL. Default matches the compose `db` service on localhost.
DATABASE_URL=postgresql+asyncpg://focus:focus@localhost:5432/focus
# Python log level for the JSON logs on stdout.
LOG_LEVEL=INFO
# Built frontend served by the app (default: <repo>/frontend/dist; absent in dev).
# FRONTEND_DIST=
# Seconds /readyz waits for the database before answering 503.
READINESS_TIMEOUT_SECONDS=2
