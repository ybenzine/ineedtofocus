{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "key-journey-prod",
      "folder": "I Need To Focus",
      "interval": "60s",
      "rules": [
        {
          "uid": "focus-session-save-errors-prod",
          "title": "Session saves failing (prod)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "grafanacloud-prom"
                },
                "expr": "((sum(increase(focus_session_saves_total{service_name=\"ineedtofocus\", deployment_environment_name=\"prod\", outcome=\"error\"}[5m]))) or vector(0)) / (sum(increase(focus_session_saves_total{service_name=\"ineedtofocus\", deployment_environment_name=\"prod\"}[5m])) > 0)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "prometheus",
                  "uid": "grafanacloud-prom"
                },
                "expr": "sum(increase(focus_session_saves_total{service_name=\"ineedtofocus\", deployment_environment_name=\"prod\"}[5m])) >= 10",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "math",
                "expression": "$A > 0.05 && $B >= 10"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "1m",
          "annotations": {
            "summary": "Over 5% of session saves are failing in prod",
            "description": "{{ humanizePercentage $values.A.Value }} of the {{ printf \"%.0f\" $values.B.Value }} sessions submitted in the last 5 minutes failed (outcome=\"error\"); the alert fires above 5% with at least 10 sessions. Users' sessions stay queued on their devices and sync once saves work again.",
            "runbook_url": "https://github.com/ybenzine/ineedtofocus/blob/main/_docs/runbooks/session-save-errors.md",
            "__dashboardUid__": "focus-key-journey-prod",
            "__panelId__": "3"
          },
          "labels": {
            "service": "ineedtofocus",
            "environment": "prod",
            "alert": "session-save-errors"
          },
          "isPaused": false
        },
        {
          "uid": "focus-history-latency-prod",
          "title": "History slow (prod)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "grafanacloud-prom"
                },
                "expr": "histogram_quantile(0.95, sum by (le) (increase(focus_history_load_duration_seconds_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"prod\"}[5m]))) > 0",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "prometheus",
                  "uid": "grafanacloud-prom"
                },
                "expr": "sum(increase(focus_history_loads_total{service_name=\"ineedtofocus\", deployment_environment_name=\"prod\"}[5m])) >= 5",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "math",
                "expression": "$A > 2 && $B >= 5"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "KeepLast",
          "for": "1m",
          "annotations": {
            "summary": "History loads are slow in prod (p95 over 2 s)",
            "description": "The 95th percentile of the {{ printf \"%.0f\" $values.B.Value }} GET /api/history loads in the last 5 minutes is {{ humanizeDuration $values.A.Value }}; the alert fires above 2 s with at least 5 loads.",
            "runbook_url": "https://github.com/ybenzine/ineedtofocus/blob/main/_docs/runbooks/history-latency.md",
            "__dashboardUid__": "focus-key-journey-prod",
            "__panelId__": "10"
          },
          "labels": {
            "service": "ineedtofocus",
            "environment": "prod",
            "alert": "history-latency"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
