{
  "uid": "focus-key-journey-dev",
  "title": "I Need To Focus: key journey (dev)",
  "description": "Save a finished session and load history, dev environment (#32). Generated by scripts/grafana_dashboards.py: change it there, not in the UI.",
  "tags": [
    "ineedtofocus",
    "key-journey",
    "dev"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-prom",
          "value": "grafanacloud-prom"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "grafanacloud-logs",
          "value": "grafanacloud-logs"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {
          "text": "grafanacloud-traces",
          "value": "grafanacloud-traces"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "I Need To Focus: key journey (prod)",
      "type": "link",
      "url": "/d/focus-key-journey-prod",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Session saves (single and offline sync)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Save success rate (time range)",
      "description": "Sessions not lost to a server error: 1 - outcome=error / all sessions submitted, single saves and sync batches together (rejected, invalid input, counts as handled). Below 95% over 5 minutes is the alert. Metric `focus_session_saves_total` (#31).",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "1 - (((sum(increase(focus_session_saves_total{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\", outcome=\"error\"}[$__range]))) or vector(0)) / sum(increase(focus_session_saves_total{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__range])))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "no data yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Save success rate (5 min windows, as the alert sees it)",
      "description": "The same ratio over sliding 5-minute windows. The dashed line is the alert threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "1 - (((sum(increase(focus_session_saves_total{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\", outcome=\"error\"}[5m]))) or vector(0)) / sum(increase(focus_session_saves_total{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[5m])))",
          "range": true,
          "legendFormat": "success rate",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Sessions saved per minute, by outcome",
      "description": "created: new; existing: a retry of one already saved (idempotent); rejected: an invalid session or an id conflict (the client's problem); error: the server failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum by (outcome) (rate(focus_session_saves_total{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])) * 60",
          "range": true,
          "legendFormat": "{{outcome}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Save latency (per request)",
      "description": "kind single: POST /api/sessions; kind sync: POST /api/sessions/sync (up to 100 sessions). Dots are exemplars: click one to open its trace.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(focus_session_save_duration_seconds_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])))",
          "range": true,
          "legendFormat": "p50 {{kind}}",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(focus_session_save_duration_seconds_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])))",
          "range": true,
          "legendFormat": "p95 {{kind}}",
          "exemplar": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, kind) (rate(focus_session_save_duration_seconds_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])))",
          "range": true,
          "legendFormat": "p99 {{kind}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Offline sync batch size",
      "description": "Sessions per POST /api/sessions/sync request. Metric `focus_sync_batch_size` (#31).",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(focus_sync_batch_size_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])))",
          "range": true,
          "legendFormat": "p50",
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(focus_sync_batch_size_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])))",
          "range": true,
          "legendFormat": "p95",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "timeseries",
      "title": "Save requests per minute, by kind and outcome",
      "description": "ok: saved (a sync batch may still hold rejected items); client_error: 4xx; error: an unexpected failure (5xx).",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum by (kind, outcome) (rate(focus_session_save_duration_seconds_count{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])) * 60",
          "range": true,
          "legendFormat": "{{kind}} {{outcome}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "type": "row",
      "title": "History loads",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "stat",
      "title": "History p95 latency (time range)",
      "description": "95th percentile of GET /api/history over the time range. Over 2 s over 5 minutes is the alert. Metric `focus_history_load_duration_seconds` (#31).",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(focus_history_load_duration_seconds_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__range])))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "no data yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "History latency",
      "description": "p50, p95 and p99 of GET /api/history. The dashed line is the alert threshold; dots are exemplars that open their trace.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(focus_history_load_duration_seconds_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])))",
          "range": true,
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(focus_history_load_duration_seconds_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])))",
          "range": true,
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(focus_history_load_duration_seconds_bucket{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])))",
          "range": true,
          "legendFormat": "p99",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "History loads per minute, by outcome",
      "description": "ok; invalid: a bad view, date or time zone (4xx); error: a server failure. Metric `focus_history_loads_total` (#31).",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum by (outcome) (rate(focus_history_loads_total{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[$__rate_interval])) * 60",
          "range": true,
          "legendFormat": "{{outcome}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "timeseries",
      "title": "History error rate (5 min windows)",
      "description": "History loads that failed on the server (outcome=error) out of all loads.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "((sum(increase(focus_history_loads_total{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\", outcome=\"error\"}[5m]))) or vector(0)) / sum(increase(focus_history_loads_total{service_name=\"ineedtofocus\", deployment_environment_name=\"dev\"}[5m]))",
          "range": true,
          "legendFormat": "error rate",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.050000000000000044
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "type": "row",
      "title": "Errors, logs and traces",
      "collapsed": false,
      "panels": [],
      "id": 13,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      }
    },
    {
      "type": "logs",
      "title": "Error logs",
      "description": "App log lines at ERROR or above (JSON logs over OTLP). Expand a line for its trace_id; the table beside it links each one to its trace.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_name=\"ineedtofocus\"} | deployment_environment_name=\"dev\" | severity_number >= 17",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "id": 14,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "type": "table",
      "title": "Error logs with their traces",
      "description": "The same lines; click a trace_id to open the trace in Explore.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_name=\"ineedtofocus\"} | deployment_environment_name=\"dev\" | severity_number >= 17",
          "queryType": "range"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "trace_id": true,
              "scope_name": true,
              "Line": true
            },
            "indexByName": {
              "Time": 0,
              "trace_id": 1,
              "scope_name": 2,
              "Line": 3
            },
            "renameByName": {
              "scope_name": "logger",
              "Line": "message"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "/explore?schemaVersion=1&panes={\"trace\":{\"datasource\":\"${traces}\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"${traces}\"},\"queryType\":\"traceql\",\"query\":\"${__data.fields.trace_id}\"}],\"range\":{\"from\":\"now-1h\",\"to\":\"now\"}}}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 280
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "id": 15,
      "gridPos": {
