# focus-prod: committed, non-secret settings for infra/compose.prod.yml (#27).
#
# Passed as the LAST --env-file, so these values win over the server's secrets file
# (/opt/focus/prod/.env): sizing and network identity are reviewed in git, not set on
# the server. Secrets never go here (see .env.example -> "Deployed environments").
# The memory budget across Caddy, prod and dev is checked by scripts/check_prod_compose.py.

FOCUS_ENV=prod
# Edge network created by infra/compose.edge.yml (project focus-edge, network `prod`).
EDGE_NETWORK=focus-edge_prod
# Caddy's fixed address on that network: the only peer whose X-Forwarded-For uvicorn
# trusts. Never `*` (clients could then spoof their address past the sign-in limiter).
FORWARDED_ALLOW_IPS=172.16.10.2

# Memory limits (hard caps). Prod gets the larger share.
APP_MEM_LIMIT=320m
DB_MEM_LIMIT=256m
OTELCOL_MEM_LIMIT=96m
# Go soft limit for the collector, about 80% of OTELCOL_MEM_LIMIT.
OTELCOL_GOMEMLIMIT=76MiB
# Postgres shared_buffers, well inside DB_MEM_LIMIT.
DB_SHARED_BUFFERS=64MB

# Under memory or CPU pressure on the host, prod wins: normal OOM score, full CPU weight.
OOM_SCORE_ADJ=0
CPU_SHARES=1024

# Password reset by email (#350): Amazon SES over HTTPS, signed with the send-only IAM user's
# key. Everything but the key is public and lives here; EMAIL_API_KEY
# (<access_key_id>:<secret_access_key>) lives only in /opt/focus/prod/.env and must never be
# set in this file. Without it the app reports password reset as not configured, cleanly.
EMAIL_PROVIDER=ses
EMAIL_AWS_REGION=us-east-1
EMAIL_FROM="I Need To Focus <no-reply@ineedtofoc.us>"
APP_BASE_URL=https://ineedtofoc.us
