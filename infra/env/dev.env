# focus-dev: committed, non-secret settings for infra/compose.prod.yml (#27).
#
# Passed as the LAST --env-file, so these values win over the server's secrets file
# (/opt/focus/dev/.env): sizing and network identity are reviewed in git, not set on
# the server. Secrets never go here (see .env.example -> "Deployed environments").
# The memory budget across Caddy, prod and dev is checked by scripts/check_prod_compose.py.

FOCUS_ENV=dev
# Edge network created by infra/compose.edge.yml (project focus-edge, network `dev`).
EDGE_NETWORK=focus-edge_dev
# Caddy's fixed address on that network: the only peer whose X-Forwarded-For uvicorn
# trusts. Never `*` (clients could then spoof their address past the sign-in limiter).
FORWARDED_ALLOW_IPS=172.16.20.2

# Memory limits (hard caps). Dev is smaller than prod.
APP_MEM_LIMIT=256m
DB_MEM_LIMIT=128m
OTELCOL_MEM_LIMIT=96m
# Go soft limit for the collector, about 80% of OTELCOL_MEM_LIMIT.
OTELCOL_GOMEMLIMIT=76MiB
# Postgres shared_buffers, well inside DB_MEM_LIMIT.
DB_SHARED_BUFFERS=32MB

# Dev must never starve prod: under host memory pressure the kernel kills dev's
# containers first, and under CPU contention dev gets a quarter of prod's weight.
OOM_SCORE_ADJ=500
CPU_SHARES=256
