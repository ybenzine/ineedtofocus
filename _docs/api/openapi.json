{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "type"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The one error format returned by every non-2xx response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "PomodoroConfig": {
        "additionalProperties": false,
        "description": "Last-used Pomodoro configuration; ranges are AC3.2.\n\nMaps to the frontend `PomodoroConfig` (timer/config.ts) in snake_case, without `mode`:\nfocusMinutes -> focus_minutes, breakMinutes -> break_minutes, blocks -> blocks,\nlongBreakEnabled -> long_break_enabled, longBreakMinutes -> long_break_minutes.",
        "properties": {
          "blocks": {
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Blocks",
            "type": "integer"
          },
          "break_minutes": {
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Break Minutes",
            "type": "integer"
          },
          "focus_minutes": {
            "maximum": 90.0,
            "minimum": 5.0,
            "title": "Focus Minutes",
            "type": "integer"
          },
          "long_break_enabled": {
            "title": "Long Break Enabled",
            "type": "boolean"
          },
          "long_break_minutes": {
            "maximum": 60.0,
            "minimum": 5.0,
            "title": "Long Break Minutes",
            "type": "integer"
          }
        },
        "required": [
          "focus_minutes",
          "break_minutes",
          "blocks",
          "long_break_enabled",
          "long_break_minutes"
        ],
        "title": "PomodoroConfig",
        "type": "object"
      },
      "SettingsOut": {
        "properties": {
          "alert_volume": {
            "description": "0-100",
            "title": "Alert Volume",
            "type": "integer"
          },
          "background_volume": {
            "description": "0-100",
            "title": "Background Volume",
            "type": "integer"
          },
          "default_reminder_minutes": {
            "anyOf": [
              {
                "enum": [
                  15,
                  30,
                  45,
                  60,
                  90,
                  120
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = Off",
            "title": "Default Reminder Minutes"
          },
          "keep_screen_awake": {
            "title": "Keep Screen Awake",
            "type": "boolean"
          },
          "last_tag": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Tag"
              },
              {
                "type": "null"
              }
            ],
            "description": "null means Work (AC7.2)"
          },
          "pomodoro_config": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PomodoroConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "null until first use"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "week_start_day": {
            "description": "0 = Sunday ... 6 = Saturday",
            "title": "Week Start Day",
            "type": "integer"
          }
        },
        "required": [
          "week_start_day",
          "alert_volume",
          "background_volume",
          "keep_screen_awake",
          "default_reminder_minutes",
          "pomodoro_config",
          "last_tag",
          "updated_at"
        ],
        "title": "SettingsOut",
        "type": "object"
      },
      "SettingsPatch": {
        "additionalProperties": false,
        "description": "Partial update: send only the fields to change. `null` is a value for\n`default_reminder_minutes` (Off), `pomodoro_config` and `last_tag` (back to none).",
        "properties": {
          "alert_volume": {
            "default": 80,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Alert Volume",
            "type": "integer"
          },
          "background_volume": {
            "default": 50,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Background Volume",
            "type": "integer"
          },
          "default_reminder_minutes": {
            "anyOf": [
              {
                "enum": [
                  15,
                  30,
                  45,
                  60,
                  90,
                  120
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Reminder Minutes"
          },
          "keep_screen_awake": {
            "default": false,
            "title": "Keep Screen Awake",
            "type": "boolean"
          },
          "last_tag": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Tag"
              },
              {
                "type": "null"
              }
            ]
          },
          "pomodoro_config": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PomodoroConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "week_start_day": {
            "default": 0,
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Week Start Day",
            "type": "integer"
          }
        },
        "title": "SettingsPatch",
        "type": "object"
      },
      "SignInRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "SignUpRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignUpRequest",
        "type": "object"
      },
      "Status": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Status",
        "type": "object"
      },
      "Tag": {
        "enum": [
          "work",
          "study",
          "nap",
          "read",
          "meditation",
          "exercise"
        ],
        "title": "Tag",
        "type": "string"
      },
      "UserOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "created_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "YoutubeLinkIn": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 2048,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "YoutubeLinkIn",
        "type": "object"
      },
      "YoutubeLinkOut": {
        "properties": {
          "last_used_at": {
            "format": "date-time",
            "title": "Last Used At",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "last_used_at"
        ],
        "title": "YoutubeLinkOut",
        "type": "object"
      },
      "YoutubeLinksOut": {
        "properties": {
          "links": {
            "description": "Newest first, at most 5",
            "items": {
              "$ref": "#/components/schemas/YoutubeLinkOut"
            },
            "title": "Links",
            "type": "array"
          }
        },
        "required": [
          "links"
        ],
        "title": "YoutubeLinksOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "I Need To Focus",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/me": {
      "get": {
        "description": "The signed-in user.",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in, or wrong email or password"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/signin": {
      "post": {
        "description": "Sign in with email and password (AC1.2); rate limited.",
        "operationId": "sign_in_api_auth_signin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in, or wrong email or password"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many failed sign-ins; see the Retry-After header"
          }
        },
        "summary": "Sign In",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/signout": {
      "post": {
        "description": "End this device's sign-in. Safe to call when already signed out.",
        "operationId": "sign_out_api_auth_signout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Sign Out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/signup": {
      "post": {
        "description": "Create an account and sign in (AC1.1). Emails are unique case-insensitively.",
        "operationId": "sign_up_api_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "An account with this email already exists"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Sign Up",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/settings": {
      "get": {
        "description": "The signed-in user's settings (AC12.1-12.5); defaults for a new user.",
        "operationId": "get_settings_api_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "summary": "Get Settings",
        "tags": [
          "settings"
        ]
      },
      "patch": {
        "description": "Change the fields sent; the rest stay as they are. Out-of-range values are 422.",
        "operationId": "update_settings_api_settings_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Update Settings",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/youtube-links": {
      "get": {
        "description": "The user's 5 most recently used YouTube links, newest first (AC8.6).",
        "operationId": "list_youtube_links_api_youtube_links_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YoutubeLinksOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "summary": "List Youtube Links",
        "tags": [
          "settings"
        ]
      },
      "post": {
        "description": "Record a link as just used (moves it to the top if known) and drop all but the 5\nnewest. Returns the updated list.",
        "operationId": "use_youtube_link_api_youtube_links_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/YoutubeLinkIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YoutubeLinksOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Use Youtube Link",
        "tags": [
          "settings"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Process is up. Does not touch the database.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Ready when the database answers.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Database down"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    }
  }
}
