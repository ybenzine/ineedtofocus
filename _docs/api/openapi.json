{
  "components": {
    "schemas": {
      "CountdownConfig": {
        "additionalProperties": false,
        "properties": {
          "minutes": {
            "maximum": 240.0,
            "minimum": 1.0,
            "title": "Minutes",
            "type": "integer"
          },
          "mode": {
            "const": "countdown",
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "minutes"
        ],
        "title": "CountdownConfig",
        "type": "object"
      },
      "DeletedCount": {
        "properties": {
          "deleted": {
            "title": "Deleted",
            "type": "integer"
          }
        },
        "required": [
          "deleted"
        ],
        "title": "DeletedCount",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "type"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The one error format returned by every non-2xx response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Mode": {
        "enum": [
          "countdown",
          "pomodoro",
          "unlimited"
        ],
        "title": "Mode",
        "type": "string"
      },
      "PomodoroConfig": {
        "additionalProperties": false,
        "properties": {
          "blocks": {
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Blocks",
            "type": "integer"
          },
          "break_minutes": {
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Break Minutes",
            "type": "integer"
          },
          "focus_minutes": {
            "maximum": 90.0,
            "minimum": 5.0,
            "title": "Focus Minutes",
            "type": "integer"
          },
          "long_break_enabled": {
            "title": "Long Break Enabled",
            "type": "boolean"
          },
          "long_break_minutes": {
            "maximum": 60.0,
            "minimum": 5.0,
            "title": "Long Break Minutes",
            "type": "integer"
          },
          "mode": {
            "const": "pomodoro",
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "focus_minutes",
          "break_minutes",
          "blocks",
          "long_break_enabled",
          "long_break_minutes"
        ],
        "title": "PomodoroConfig",
        "type": "object"
      },
      "SessionEdit": {
        "additionalProperties": false,
        "description": "Change the tag and/or goal (AC11.1). `goal: null` (or blank) clears the goal.",
        "properties": {
          "goal": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "tag": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Tag"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "SessionEdit",
        "type": "object"
      },
      "SessionIn": {
        "additionalProperties": false,
        "description": "A finished session as the client saved it on the device (AC6.3, AC13.2).",
        "properties": {
          "blocks_completed": {
            "default": 0,
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Blocks Completed",
            "type": "integer"
          },
          "ended_at": {
            "format": "date-time",
            "title": "Ended At",
            "type": "string"
          },
          "focus_seconds": {
            "maximum": 43200.0,
            "title": "Focus Seconds",
            "type": "integer"
          },
          "goal": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "mode_config": {
            "discriminator": {
              "mapping": {
                "countdown": "#/components/schemas/CountdownConfig",
                "pomodoro": "#/components/schemas/PomodoroConfig",
                "unlimited": "#/components/schemas/UnlimitedConfig"
              },
              "propertyName": "mode"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/CountdownConfig"
              },
              {
                "$ref": "#/components/schemas/PomodoroConfig"
              },
              {
                "$ref": "#/components/schemas/UnlimitedConfig"
              }
            ],
            "title": "Mode Config"
          },
          "paused_seconds": {
            "minimum": 0.0,
            "title": "Paused Seconds",
            "type": "integer"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status-Input"
          },
          "tag": {
            "$ref": "#/components/schemas/Tag"
          }
        },
        "required": [
          "id",
          "mode",
          "tag",
          "started_at",
          "ended_at",
          "focus_seconds",
          "paused_seconds",
          "status",
          "mode_config"
        ],
        "title": "SessionIn",
        "type": "object"
      },
      "SessionList": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionOut"
            },
            "title": "Sessions",
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "title": "SessionList",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "blocks_completed": {
            "title": "Blocks Completed",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "ended_at": {
            "format": "date-time",
            "title": "Ended At",
            "type": "string"
          },
          "focus_seconds": {
            "title": "Focus Seconds",
            "type": "integer"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "mode_config": {
            "discriminator": {
              "mapping": {
                "countdown": "#/components/schemas/CountdownConfig",
                "pomodoro": "#/components/schemas/PomodoroConfig",
                "unlimited": "#/components/schemas/UnlimitedConfig"
              },
              "propertyName": "mode"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/CountdownConfig"
              },
              {
                "$ref": "#/components/schemas/PomodoroConfig"
              },
              {
                "$ref": "#/components/schemas/UnlimitedConfig"
              }
            ],
            "title": "Mode Config"
          },
          "paused_seconds": {
            "title": "Paused Seconds",
            "type": "integer"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/app__models__enums__Status"
          },
          "tag": {
            "$ref": "#/components/schemas/Tag"
          }
        },
        "required": [
          "id",
          "mode",
          "tag",
          "goal",
          "started_at",
          "ended_at",
          "focus_seconds",
          "paused_seconds",
          "status",
          "mode_config",
          "blocks_completed",
          "archived_at",
          "created_at"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "SignInRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "SignUpRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignUpRequest",
        "type": "object"
      },
      "Status-Input": {
        "enum": [
          "completed",
          "ended_early"
        ],
        "title": "Status",
        "type": "string"
      },
      "SyncRequest": {
        "additionalProperties": false,
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionIn"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Sessions",
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "title": "SyncRequest",
        "type": "object"
      },
      "SyncResult": {
        "description": "`created` are new; `existing` were already saved (their stored copy is returned).\n`sessions` follows the request order.",
        "properties": {
          "created": {
            "title": "Created",
            "type": "integer"
          },
          "existing": {
            "title": "Existing",
            "type": "integer"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionOut"
            },
            "title": "Sessions",
            "type": "array"
          }
        },
        "required": [
          "created",
          "existing",
          "sessions"
        ],
        "title": "SyncResult",
        "type": "object"
      },
      "Tag": {
        "enum": [
          "work",
          "study",
          "nap",
          "read",
          "meditation",
          "exercise"
        ],
        "title": "Tag",
        "type": "string"
      },
      "UnlimitedConfig": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "const": "unlimited",
            "title": "Mode",
            "type": "string"
          },
          "reminder_minutes": {
            "anyOf": [
              {
                "enum": [
                  15,
                  30,
                  45,
                  60,
                  90,
                  120
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reminder Minutes"
          }
        },
        "required": [
          "mode",
          "reminder_minutes"
        ],
        "title": "UnlimitedConfig",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "created_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "app__health__Status": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Status",
        "type": "object"
      },
      "app__models__enums__Status": {
        "enum": [
          "completed",
          "ended_early"
        ],
        "title": "Status",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "I Need To Focus",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/me": {
      "get": {
        "description": "The signed-in user.",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in, or wrong email or password"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/signin": {
      "post": {
        "description": "Sign in with email and password (AC1.2); rate limited.",
        "operationId": "sign_in_api_auth_signin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in, or wrong email or password"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many failed sign-ins; see the Retry-After header"
          }
        },
        "summary": "Sign In",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/signout": {
      "post": {
        "description": "End this device's sign-in. Safe to call when already signed out.",
        "operationId": "sign_out_api_auth_signout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Sign Out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/signup": {
      "post": {
        "description": "Create an account and sign in (AC1.1). Emails are unique case-insensitively.",
        "operationId": "sign_up_api_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "An account with this email already exists"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Sign Up",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "description": "Save one finished session (AC6.3). Idempotent on `id` (AC13.4): a repeat returns 200 with\nthe stored session and changes nothing.",
        "operationId": "save_session_api_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "OK"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such session"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict (see message)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Save Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/archived": {
      "delete": {
        "description": "Permanently delete every archived session and return how many (AC11.6). Non-archived\nsessions are never touched, and no endpoint deletes one (AC11.7).",
        "operationId": "delete_archived_api_sessions_archived_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedCount"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such session"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict (see message)"
          }
        },
        "summary": "Delete Archived",
        "tags": [
          "sessions"
        ]
      },
      "get": {
        "description": "The Archive view (AC11.3): archived sessions, most recently archived first.",
        "operationId": "list_archived_api_sessions_archived_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionList"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such session"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict (see message)"
          }
        },
        "summary": "List Archived",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/sync": {
      "post": {
        "description": "Save a batch of up to 100 sessions (AC13.3), idempotent per `id` (AC13.4). The whole\nbatch is rejected with 422 if any session is invalid; `details[].field` names it\n(`sessions.2.focus_seconds`).",
        "operationId": "sync_sessions_api_sessions_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such session"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict (see message)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Sync Sessions",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}": {
      "patch": {
        "description": "Change tag and/or goal of a non-archived session (AC11.1). Archived sessions are\nread-only (AC11.4): 409.",
        "operationId": "edit_session_api_sessions__session_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionEdit"
              }
            }
          },
